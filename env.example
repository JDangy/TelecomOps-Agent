# =============================================================================
# TelecomOps-Agent 环境变量配置
# 复制为 .env 并填写你的 API key。不要将 .env 提交到 git。
#
# 注意：你的 Claude Code 全局权限 deny 了 "Read(./.env.*)"，因此本文件
# 命名为 env.example。可手动执行 `mv env.example .env.example` 恢复标准命名。
# =============================================================================

# --- LLM 提供商（通过 LiteLLM）---
# 本项目使用 DeepSeek 作为默认 LLM，任何 LiteLLM 支持的提供商均可。
# 选择一个提供商并填写对应 key：

# DeepSeek
DEEPSEEK_API_KEY=

# OpenAI（如果用 OpenAI 模型）
# OPENAI_API_KEY=

# Anthropic（如果用 Claude 模型，或 api.b.ai 等 Anthropic 兼容端点）
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.b.ai

# OpenRouter（聚合供应商）
# OPENROUTER_API_KEY=

# 自定义 OpenAI 兼容端点（可选，如 vLLM / Ollama 网关）
# OPENAI_BASE_URL=

# --- Evaluation 默认模型 ---
# agent 使用的模型（LiteLLM 格式，如 deepseek/deepseek-chat）
# TELECOMOPS_AGENT_LLM=deepseek/deepseek-chat

# user simulator 使用的模型（LiteLLM 格式）
# TELECOMOPS_USER_LLM=deepseek/deepseek-chat

# --- 运行参数（可选，均可通过 CLI 覆盖）---
# 每个任务最大轮数
# TELECOMOPS_MAX_STEPS=60
# 随机种子
# TELECOMOPS_SEED=42
